# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co

# Service role (secret) key — Supabase Dashboard > Settings > API > service_role.
# Server-only. Never expose this to a frontend/browser or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
